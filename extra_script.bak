import os
import gzip
import shutil
from SCons.Script import DefaultEnvironment

# Hier legst du fest, welche Endungen gezippt werden sollen
GZIP_EXTENSIONS = ('css', 'html', 'js', 'ico')

def gzip_data_folder(source, target, env):
    project_dir = env.get("PROJECT_DIR")
    data_dir = os.path.join(project_dir, "data")
    
    print("[Gzip Script] Starte Komprimierung der Web-Dateien...")

    for root, dirs, files in os.walk(data_dir):
        for file in files:
            file_path = os.path.join(root, file)
            rel_path = os.path.relpath(file_path, data_dir)

            # Beispiel: Zusätzliche Pfade umsetzen/verschieben
            # Wenn eine Datei "index.html" heißt, wird sie im Dateisystem
            # unter "/unterordner/index.html.gz" gespeichert.
            if file == "wifi_config.json":
                target_path = os.path.join(data_dir, "config")
            else:
                target_path = file_path + ".gz"

            # Ziel-Ordner sicherstellen
            target_dir = os.path.dirname(target_path)
            if not os.path.exists(target_dir):
                os.makedirs(target_dir)

            # Prüfen, ob gezippt werden soll
            if file.endswith(GZIP_EXTENSIONS) and not file.endswith(".gz"):
                with open(file_path, 'rb') as f_in:
                    # mtime=0 sorgt für deterministische Build-Ergebnisse
                    with gzip.GzipFile(target_path, 'wb', compresslevel=9, mtime=0) as f_out:
                        shutil.copyfileobj(f_in, f_out)
                print(f"[Gzip] Komprimiert: {rel_path} -> {os.path.basename(target_path)}")
            
            # Alle anderen Dateien (z.B. Bilder) einfach kopieren oder an Ort und Stelle lassen
            # (Dieser Block kann entfernt werden, wenn Originaldateien unverändert im data-Ordner bleiben sollen)
            elif not file.endswith(".gz") and file_path != target_path:
                 shutil.copy2(file_path, target_path)

    print("[Gzip Script] Vorbereitung abgeschlossen.")

env = DefaultEnvironment()

# Hängt das Skript VOR den Build-Vorgang des Dateisystems
# (Je nach verwendetem Board/Filesystem muss 'spiffs.bin' oder 'littlefs.bin' verwendet werden)
env.AddPreAction("$BUILD_DIR/spiffs.bin", gzip_data_folder)
env.AddPreAction("$BUILD_DIR/littlefs.bin", gzip_data_folder)