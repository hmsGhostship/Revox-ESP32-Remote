	(text "J1					Revox B203\nJST 6pol.			DIN 6pol.\n1					1 (gnd)\n2					2 (gnd)\n3					3 (SerialLink)\n4					4 (nc)\n5					5 (+5V)\n6					6 (nc)"
		(exclude_from_sim no)
