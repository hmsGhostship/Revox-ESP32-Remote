	(text "GND = Revox GND pin2\nRS232_RXD = Revox IN Pin4\nRS232_TXD = Revox OUT pin3\n\nEnable RS232 Brücke Pin10 - Pin4\nDisable IR LEDs Brücke PIN10 - PIN6"
		(exclude_from_sim no)
		(at 153.67 141.478 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "8a4ffb06-aa34-4738-b147-b4000460953b")
	)
	(text "JST 10pol	DIN 8pol	Bez.\n1			2 (sw)		Gnd\n2			4 (gn)		Revox TXD\n3			3 (ge)		Revox RXD\n4			5 			RS232 +5V\n10			1			+5V\n6			8 (rt)		/EN2\n7			7 (or)		RTS\n8			6 (br)		CTS"
		(exclude_from_sim no)
		(at 182.372 154.178 0)
		(effects
