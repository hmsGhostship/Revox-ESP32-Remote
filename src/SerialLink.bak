#include "SerialLink.h"

void setupSLoutPin() {
    pinMode(SLoutPin1, OUTPUT);
    pinMode(SLoutPin2, OUTPUT);
}

void SLoutPin(bool status) {
  digitalWrite(SLoutPin1, status);
  digitalWrite(SLoutPin2, status);
}

// Hilfsfunktion: Erzeugt den reinen unmodulierten 15µs Infrarot-Puls
void transmitRawPulse() {
  SLoutPin(HIGH);
  delayMicroseconds(PULSE_DURATION);
  SLoutPin(LOW);
}

// Hilfsfunktion, um ein einzelnes Bit mit dem exakten Timing zu senden
void sendSingleBit(bool bitValue) {
  transmitRawPulse();
  if (bitValue == 0) {
    delayMicroseconds(LOGIC_0_DELAY);
  } else {
    delayMicroseconds(LOGIC_1_DELAY);
  }
}

void sendRevoxFrame(uint8_t Address, uint8_t ircmd, int repetitions) {

  // ZURÜCK ZUM ORIGINAL: Das "- 1" MUSS hier stehen bleiben, 
  // damit aus der JSON-15 (0x0F) im Speicher die 14 (1110) wird!
  byte adresse = Address - 1;
  uint16_t dataPayload = ((ircmd & 0x3F) << 4) | (adresse & 0x0F);

  // Zeigt im Monitor wieder das funktionierende Muster (z.B. 1100011110)
  Serial.println(dataPayload, BIN); 

  noInterrupts(); // Hardware-Schutzschild aktiv halten

  for (int r = 0; r < repetitions; r++) {
    uint16_t tempPayload = dataPayload; // Kopie schützen

    transmitRawPulse();
    delayMicroseconds(REVOX_LONG_PAUSE); 
    sendSingleBit(0); 

    // UNBEDINGT RECHTS-NACH-LINKS (Original-Schleife!)
    for (int b = 0; b <= 9; b++) {
      bool currentBit = tempPayload & 1; 
      sendSingleBit(currentBit);
      tempPayload >>= 1; 
    }

    transmitRawPulse();
    delayMicroseconds(REVOX_LONG_PAUSE); 
    transmitRawPulse();

    if (r < (repetitions - 1)) { delayMicroseconds(FRAME_DELAY); }
  }
  delayMicroseconds(FRAME_DELAY);
  interrupts();
}