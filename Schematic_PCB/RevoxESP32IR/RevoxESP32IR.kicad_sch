	(text "#define TXD2 pin 16\n#define RXD2 pin 17"
		(exclude_from_sim no)
		(at 69.85 76.708 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "421cebc8-d116-4fb5-83cc-69e158e3b8b6")
	)
	(text "JST 10pol	DIN 8pol	Bez.			Hinweis\n1			2			Gnd				\n2			4			Revox TXD		\n3			3			Revox RXD		\n4			5			RS232 +5V		\n10			1			+5V				\n7			7			RTS				nicht verwendet\n8			6			CTS				nicht verwendet"
		(exclude_from_sim no)
		(at 179.07 154.94 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "42d3fe12-70ca-4157-a65f-7d1bdc852974")
	)
	(text "Wichtig, das SerialLink Kabel muss \nan Port A angeschlossen werden\nund er Jumper JS1 auf der B203\nHauptplatine muss auf Stellung R gesteckt sein."
		(exclude_from_sim no)
		(at 259.588 18.542 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6ef9a249-5ae7-458b-bb0a-569fa261fc58")
	)
	(text "GND = Revox GND pin2\nRS232_RXD = Revox IN Pin4\nRS232_TXD = Revox OUT pin3\n\nEnable RS232 Brücke Pin10 - Pin4\nDisable IR LEDs Brücke PIN10 - PIN6"
		(exclude_from_sim no)
		(at 129.54 140.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8a4ffb06-aa34-4738-b147-b4000460953b")
	)
	(text "Disable IR LEDs Brücke PIN4 - PIN6"
		(exclude_from_sim no)
		(at 210.058 24.892 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "92ca37f1-e913-49dc-9a0d-b006fcc5eef0")
	)
	(text "Lötseite"
