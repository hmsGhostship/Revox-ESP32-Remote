struct portcnf {
  char name[5];
  char descr[12];
  char out[3];
  bool feedback;
};

struct command {
    char btnID[20];
    uint32_t irRecvCode;
    uint8_t address;
    uint8_t command;
    uint8_t cmdFlag;
    char serCmd[8];
    bool repeat;
    char device[20];
};

